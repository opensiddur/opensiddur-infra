# Not .bundle/: deploy.sh writes the upstream pins it chose there, and the image build
# must read the same ones (do not #!include:.gitignore, which lists it).
.git
.gitignore
.venv
**/__pycache__
**/node_modules
web/dist
infrastructure/.terraform
**/*.tfstate*
**/*.tfplan
**/*.auto.tfvars
.runtime
.pytest_cache
.ruff_cache

.env
.env.*
gha-creds-*.json
**/*.tsbuildinfo
